{
  "name": "aura-ai-coach",
  "version": "1.0.0",
  "description": "Aura AI Coach — Cardiac wellness companion app with real-time telemetry analytics and AI coaching insights",
  "main": "index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoomanp/aura-ai-coach.git"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand --no-watchman",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --no-watchman --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src App.tsx",
    "mcp:server": "tsx --tsconfig tsconfig.mcp.json src/mcp/server-cli.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "expo": "~55.0.6",
    "expo-font": "~55.0.8",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "victory-native": "^36.9.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "uuid": "^11.1.1"
  }
}
